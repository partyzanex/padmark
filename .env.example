# padmark server/Compose configuration — copy to .env and adjust. See README.md.
# Most PADMARK_* values also have a `serve` flag (e.g. PADMARK_ADDR -> --addr).
# PADMARK_BOOTSTRAP_TOKEN is environment-only; POSTGRES_PASSWORD is Compose-only.

# ── Core ──────────────────────────────────────────────────────────────────────
PADMARK_ADDR=:8080                       # listen address; match your proxy/healthcheck
PADMARK_STORAGE=sqlite                   # sqlite | postgres
# sqlite: use an ABSOLUTE path on a persistent volume (the default is relative → lost on redeploy)
# postgres: PADMARK_DSN=postgres://user:pass@db:5432/padmark?sslmode=require
PADMARK_DSN=/var/lib/padmark/padmark.db

# ── docker-compose.yml only ──────────────────────────────────────────────────
# Required by docker-compose.yml (db password + the padmark DSN). The raw value goes to Postgres
# AND is interpolated into the DSN, so do NOT URL-encode it — use URL-safe characters only
# (letters, digits, `-._~`), e.g. generate with `openssl rand -hex 32`.
# The DB port is bound to 127.0.0.1 only — never exposed to other hosts.
POSTGRES_PASSWORD=change-me
# Bundled Compose image default. Match the image repository/tag used by your build/CI.
# DOCKER_IMAGE=partydev/padmark
# DOCKER_TAG=latest

# Optional explicit keyring. Without this setting, serve creates padmark-keys.json beside
# the SQLite DB or in the working directory for PostgreSQL (/data in the container).
# Persist /data across container replacements. Startup migrates existing content automatically.
# An explicitly named file must already exist; encryption tools never create one implicitly.
# Keep keys across restarts and back them up separately from the DB (see README).
# PADMARK_CONTENT_KEYRING_FILE=/etc/padmark/content-keys.json
# Only for secret managers that cannot supply owner-only permissions (logs a warning).
# PADMARK_ALLOW_SHARED_KEYRING=false
# Existing SQLite databases are backed up before pending schema migrations unless opted out.
# PADMARK_SKIP_MIGRATION_BACKUP=false

PADMARK_LOG_LEVEL=info                   # debug | info | warn | error  (debug shows remote/xff/user)
PADMARK_LOG_FORMAT=json                  # json | text

# ── TLS (terminate in-app; leave empty if the proxy terminates TLS) ───────────
# PADMARK_TLS_CERT=/etc/padmark/tls.crt
# PADMARK_TLS_KEY=/etc/padmark/tls.key
# PADMARK_HTTP_REDIRECT_ADDR=:80         # HTTP->HTTPS redirect listener (only with TLS)
# PADMARK_ALLOWED_HOSTS=example.com,www.example.com   # main + redirect listeners; health probes exempt

# ── Behind a reverse proxy / load balancer ───────────────────────────────────
# Set to the proxy's SOURCE CIDR (what padmark sees as RemoteAddr). Read it from the request log
# fields `remote=`/`xff=`. Without this, clients behind a proxy share its rate-limit bucket.
# TLS terminated at that proxy also needs trusted X-Forwarded-Proto or PUBLIC_SCHEME below
# for HSTS/Secure cookies. PUBLIC_SCHEME changes scheme detection, not client-IP resolution.
# NEVER use 0.0.0.0/0: trusting every address means any client's X-Real-IP is believed, so it can
# pick a fresh rate-limit bucket per request and slip the TOTP login cap. Ranges that wide are
# warned about at startup.
# PADMARK_TRUSTED_PROXIES=10.0.0.0/8
# Force the scheme (http | https) for absolute links back to this server (note URLs, invite links,
# API-token envelopes) instead of detecting it from TLS/X-Forwarded-Proto; https also sets the
# Secure attribute on session/CSRF cookies and enables HSTS. Use when the proxy's IP is not stable
# enough for PADMARK_TRUSTED_PROXIES (cloud load balancers, k8s ingress).
# PADMARK_PUBLIC_SCHEME=https

# ── Rate limiting ────────────────────────────────────────────────────────────
PADMARK_RATE_LIMIT=10                    # req/s per client IP; 0 disables
PADMARK_RATE_BURST=20

# ── Request size limits ──────────────────────────────────────────────────────
PADMARK_MAX_BODY_BYTES=4194304           # 4 MB
PADMARK_MAX_HEADER_BYTES=65536           # 64 KB
PADMARK_READ_TIMEOUT=30                  # seconds
PADMARK_WRITE_TIMEOUT=60                 # seconds

# ── Features ─────────────────────────────────────────────────────────────────
# Disable the REST/JSON API (/notes*, /links*, /api, /api/openapi.yaml, /llms.txt, /api/tokens,
# /api/invites → 503 code=api_disabled). The editor becomes read-only: viewing still works, but
# publishing/saving from the editor fails (it calls POST /notes and PUT /notes/{id}).
# PADMARK_DISABLE_API=false
# Short-link GET /r/{hash}. Default false: links created ANONYMOUSLY open an interstitial page
# (meta-refresh + noscript fallback) showing the destination, so the instance is not a free open
# redirector; links created by a signed-in owner still get an immediate 301. Set true to get a
# 301 for every link (the behaviour before this default changed).
# PADMARK_DIRECT_REDIRECT=false
# Allow user-supplied human-readable note slugs (e.g. project/GUIDE.md) and short-link aliases
# (single segment). On by default, as in v0.1.6; set false to issue only random slugs, because
# human-readable public URLs are easier to guess.
# PADMARK_CUSTOM_SLUGS=true

# ── Metrics ──────────────────────────────────────────────────────────────────
# Separate internal Prometheus /metrics listener (e.g. :9090); empty (default) disables it.
# Bind to a private interface only — metrics are never served on the public listener.
# PADMARK_METRICS_ADDR=

# ── Accounts (TOTP login / /admin / private notes) — OFF by default (public) ──
PADMARK_ENABLE_ACCOUNTS=false            # true → open /setup over HTTPS to create the first admin
# Proof of server ownership for creating the first admin via /setup (no invite); at least 32
# characters, environment only (never a flag). Unset = first-admin setup is disabled, so whoever
# reaches /setup first cannot become the permanent admin. Generate with `openssl rand -hex 32`,
# enter it in the /setup form (or export it for `padmark-cli setup`), and unset it afterwards.
# PADMARK_BOOTSTRAP_TOKEN=
# PADMARK_TOTP_ISSUER=padmark
# PADMARK_SESSION_TTL=2592000            # 30 days
# HMAC key for CSRF form tokens; raw bytes, at least 32 characters (shorter = startup error).
# Empty (default) = a fresh random key per process: fine for one instance, but restarts
# invalidate open forms and multiple replicas 403 each other's form submits. Generate with
# `openssl rand -base64 32` and use the same value on every replica.
# PADMARK_CSRF_SECRET=

# Configurable argon2id cost for account passwords, caller-chosen edit codes and TOTP secret
# wrapping; ~24 MiB per new hash. Generated edit codes use salted SHA-256.
# Safe to change within supported bounds on a live deployment: every stored hash and encrypted secret carries the cost it
# was written with, so existing accounts keep working. TOTP secrets are rewritten at the new cost
# on their owner's next login; password hashes, on the next password change.
# Bounds: memory <=262144 KiB, iterations <=10, threads <=16; memory >=8*threads.
# PADMARK_ARGON2_MEMORY=24576
# PADMARK_ARGON2_TIME=2
# PADMARK_ARGON2_THREADS=1

# Total argon2id memory (KiB) that concurrent password, edit-code and TOTP-key
# derivations may hold at once; further requests queue. Default 131072 (128 MiB). Must be
# >= PADMARK_ARGON2_MEMORY. Pair it with GOMEMLIMIT at ~75-80% of the container memory limit:
# the budget bounds live argon2 memory, GOMEMLIMIT makes the GC reclaim finished derivations.
# Example for a 256 MB container: GOMEMLIMIT=200MiB, PADMARK_ARGON2_MEMORY=19456,
# PADMARK_ARGON2_MEMORY_BUDGET=65536.
# PADMARK_ARGON2_MEMORY_BUDGET=131072
# GOMEMLIMIT=200MiB  # Go runtime variable, not a padmark flag
